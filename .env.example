# Server
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5000

# MongoDB (Atlas connection string in production)
MONGO_URI=mongodb://127.0.0.1:27017/quiz_master

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRE=15m
JWT_REFRESH_SECRET=change_me_to_another_long_random_string
JWT_REFRESH_EXPIRE=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# AI question generation (Anthropic Claude). Get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key

# Default admin (created by `npm run seed`)
ADMIN_NAME=System Administrator
ADMIN_EMAIL=admin@quizmaster.com
ADMIN_PASSWORD=Admin@1234
